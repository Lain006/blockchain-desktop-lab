{
  "name": "blockchain-desktop-lab",
  "version": "1.0.0",
  "private": true,
  "description": "本机区块链教学控制台",
  "author": "Lain006",
  "main": "desktop/main.cjs",
  "scripts": {
    "build:ui": "vite build --config desktop/vite.config.mjs",
    "build": "npm --prefix frontend run build && npm run build:ui",
    "start": "npm run build && electron .",
    "typecheck": "vue-tsc --noEmit -p desktop/tsconfig.json",
    "test": "node --test desktop/tests/*.test.cjs",
    "test:desktop": "node desktop/tests/acceptance.cjs",
    "package": "npm run build && node -e \"require('electron')\" && electron-builder --win zip --x64",
    "postinstall": "node scripts/install-workspaces.cjs",
    "setup": "node scripts/install-workspaces.cjs",
    "test:backend": "npm --prefix blockchaindemo test",
    "test:web": "npm --prefix frontend run typecheck && npm --prefix frontend test",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "docs:screenshots": "node scripts/capture-desktop.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "build": {
    "appId": "io.github.lain006.blockchainlab",
    "productName": "区块链教学控制台",
    "electronDist": "node_modules/electron/dist",
    "extraFiles": [
      {
        "from": "desktop/使用说明.txt",
        "to": "使用说明.txt"
      }
    ],
    "directories": {
      "output": "delivery"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/ui/**/*",
      "blockchaindemo/*.js",
      "!blockchaindemo/test-*.js",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Blockchain-Lab-${version}-win-x64.${ext}"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
